# Object Storage credentials for the reckoning-live Hetzner project. Used by the
# Terraform S3 state backend and by scripts/import-storage.sh as the upload
# target. Terraform's own bucket resources take their credentials from the
# HETZNER_S3_LIVE / HETZNER_S3_STAGE 1Password items instead, so that each
# workspace writes into its own project.
export AWS_ACCESS_KEY_ID=<<YOUR_HETZNER_LIVE_S3_ACCESS_KEY>>
export AWS_SECRET_ACCESS_KEY=<<YOUR_HETZNER_LIVE_S3_SECRET_KEY>>

# Required locally: the 1Password provider shells out to the `op` CLI, which
# needs to know which account to use when more than one is signed in. Without
# it the provider fails with "Invalid provider configuration".
export OP_ACCOUNT=my.1password.eu

# CI only — a service account token replaces OP_ACCOUNT there.
# export OP_SERVICE_ACCOUNT_TOKEN=<<YOUR_1PASSWORD_SERVICE_ACCOUNT_TOKEN>>
