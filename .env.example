# Hetzner Object Storage credentials — used for the Terraform S3 state backend
# and by scripts/migrate-storage.sh as the sync target.
export AWS_ACCESS_KEY_ID=<<YOUR_HETZNER_S3_ACCESS_KEY>>
export AWS_SECRET_ACCESS_KEY=<<YOUR_HETZNER_S3_SECRET_KEY>>

# Legacy DigitalOcean Spaces credentials — only needed while migrating
# Active Storage blobs. Delete once the cutover is done.
export DO_SPACES_KEY=<<YOUR_DO_SPACES_KEY>>
export DO_SPACES_SECRET=<<YOUR_DO_SPACES_SECRET>>

# CI only. Locally, `op signin` is enough for the 1Password provider.
# export OP_SERVICE_ACCOUNT_TOKEN=<<YOUR_1PASSWORD_SERVICE_ACCOUNT_TOKEN>>
